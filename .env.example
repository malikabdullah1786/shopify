# Shopify App Credentials
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret

# Scopes determine the permissions your app has.
# Find available scopes at: https://shopify.dev/docs/api/admin-oauth/access-scopes
SHOPIFY_SCOPES=write_products,write_orders,write_script_tags

# The public URL of your app. Use a tunneling service like ngrok for local development.
# Example: https://your-ngrok-subdomain.ngrok.io
HOST=https://your_app_host.com

# The version of the Shopify Admin API you are targeting.
# Example: 2024-01
SHOPIFY_API_VERSION=2023-10